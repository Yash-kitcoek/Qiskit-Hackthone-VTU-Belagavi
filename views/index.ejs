<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quara</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Quara posts</h1>

    <% posts.forEach((post) => { %>

        <div class="post">
            <h2 class="post-title"><%= post.title %></h2>
            <h3 class="post-author">By: <%= post.username %></h3>
            <p class="post-content"><%= post.content %></p>
        </div>

        <hr>

    <% }); %>

</body>
</html>