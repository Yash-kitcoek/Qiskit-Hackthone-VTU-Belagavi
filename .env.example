# Copy to .env and fill in your own credentials. Never commit .env.
PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Identity document encryption. Use a long random secret; if omitted, JWT_SECRET is used.
DOCUMENT_ENCRYPTION_KEY=

# Razorpay (use test keys while developing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP email delivery (for broker verification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
